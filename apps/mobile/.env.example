# Mobile App Environment Variables
# Copy this file to .env and fill in your values

# Expo Configuration
EXPO_USE_METRO_WORKSPACE_ROOT=1

# API Configuration
# For local development, use localhost (iOS simulator) or your computer's IP (Android/physical device)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Payment Configuration
# Get this from your Stripe dashboard: https://dashboard.stripe.com/test/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Product analytics (PostHog) - mobile counterpart of apps/web's NEXT_PUBLIC_POSTHOG_KEY.
# Leave the key unset in dev, CI and E2E: analytics is then a complete no-op
# (the SDK isn't loaded and nothing is sent). See docs/mobile-analytics.md.
# EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
# Optional; defaults to the same PostHog reverse proxy as web.
# EXPO_PUBLIC_POSTHOG_HOST=https://stuff.cahootzcoops.com

# Note: For testing on physical devices or Android emulator, replace localhost with your computer's IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3001
# You can find your IP by running: ipconfig getifaddr en0 (macOS)
