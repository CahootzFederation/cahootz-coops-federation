{
  "expo": {
    "name": "Cahootz Commons",
    "slug": "cahootz-coop",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "scheme": "commons",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF7E7"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d6eac9aa-edde-46f3-b75e-6fcad6e89359"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cahootzcoops.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cahootzcoops.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FBF7E7"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d6eac9aa-edde-46f3-b75e-6fcad6e89359"
      },
      "router": {}
    },
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "./expo-plugins/with-excluded-archs.js",
      "./expo-plugins/with-modify-gradle.js",
      [
        "expo-camera",
        {
          "cameraPermission": "Cahootz Commons uses your camera to scan QR codes and let you take profile, store, or product photos and short videos for upload."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cahootz Commons uses your photo library so you can choose profile, store, product, or gallery photos and short videos to upload.",
          "cameraPermission": "Cahootz Commons uses your camera to let you take profile, store, or product photos and short videos for upload.",
          "microphonePermission": "Cahootz Commons uses your microphone only when you record a short video, so the uploaded clip can include audio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F97316",
          "defaultChannel": "commons"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Cahootz Commons to use Face ID for authentication."
        }
      ]
    ],
    "owner": "cahootz-coop",
    "runtimeVersion": "1.1.0"
  }
}
