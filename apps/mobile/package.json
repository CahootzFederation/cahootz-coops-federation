    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "eslint-config-expo": "~55.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.2.0",
    "serve": "^14.2.6",
    "typescript": "catalog:"
