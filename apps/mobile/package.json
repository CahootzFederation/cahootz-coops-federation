{
  "name": "@cahootz/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "scripts": {
    "eas-build-post-install": "pnpm --filter @repo/validators build --incremental false",
    "validate-env": "tsx ./scripts/validate-env.ts",
    "start": "expo start",
    "dev:production": "EXPO_NO_DOTENV=1 dotenv -e .env.production -o -- expo start --dev-client --clear",
    "dev": "expo start --web",
    "dev:ios": "expo start --ios",
    "web": "expo start --web",
    "android": "expo run:android",
    "export:web": "NODE_ENV=production pnpm run validate-env && NODE_ENV=production expo export --platform web",
    "serve:web": "serve dist -p 3000",
    "lint": "expo lint",
    "clean": "git clean -xdf .expo .turbo node_modules",
    "lint:fix": "pnpm lint --fix",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:fast": "playwright test --grep-invert @sage",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ]
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@repo/validators": "workspace:*",
    "@rn-primitives/checkbox": "^1.2.0",
    "@rn-primitives/label": "^1.2.0",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/slot": "^1.2.0",
    "@sentry/react-native": "^7.11.0",
    "@stripe/react-stripe-js": "^5.4.1",
    "@stripe/stripe-js": "^8.6.1",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "catalog:",
