    "expo-web-browser": "~55.0.20",
    "lucide-react-native": "^0.544.0",
    "markdown-it": "^10.0.0",
    "nativewind": "^4.2.1",
    "posthog-react-native": "^4.78.0",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "0.83.10",
    "react-native-controlled-mentions": "^3.1.0",
